# Release image: package the boot jar that the verify gate built (backend/build/libs/quiz-room.jar) on a JRE,
# running as a non-root user. Nothing is compiled here, so the shipped jar is exactly the tested one.
FROM eclipse-temurin:25-jre
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 --home /app quiz
WORKDIR /app
COPY build/libs/quiz-room.jar app.jar
USER quiz
EXPOSE 8080
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75", "-jar", "/app/app.jar"]
