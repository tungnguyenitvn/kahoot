# Release image: serve the Angular bundle that the verify gate built (frontend/dist/quiz-room-ui/browser) from
# nginx and proxy /api and /ws to the backend service. Nothing is compiled here.
FROM nginx:1.29-alpine
COPY nginx.release.conf /etc/nginx/conf.d/default.conf
COPY dist/quiz-room-ui/browser /usr/share/nginx/html
EXPOSE 80
